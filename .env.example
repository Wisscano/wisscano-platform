# Set these when upgrading to the WhatsApp Business/Meta Cloud API adapter:
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_API_PHONE_ID=""

# ---- Email notifications (optional, NotificationService email provider) ----
